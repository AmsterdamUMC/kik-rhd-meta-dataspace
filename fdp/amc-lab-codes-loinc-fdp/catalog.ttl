    dcat:landingPage <https://kik.amsterdamumc.org/reusable-health-data/> ;
    dcat:dataset :amsterdam-umc-lab-codes-to-loinc .

:amsterdam-umc-lab-codes-to-loinc
    a dcat:Dataset ;
    dcterms:title "Amsterdam UMC lab codes to LOINC"@en ;
    dcterms:description "Not public. Contact the Reusable Health Data research line for collaboration on lab-code mappings."@en ;
    dcat:version "live (described 2026-11-07)" ;
    dcterms:publisher :publisher-source ;
    dcat:distribution :dist-contact-reusable-health-data-kik .

:dist-contact-reusable-health-data-kik
