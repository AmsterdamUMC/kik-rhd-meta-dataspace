<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/amc-lab-codes-loinc-fdp/catalog.ttl#catalog>
    a dcat:Catalog ;
    dcterms:title "Amsterdam UMC lab codes to LOINC"@en ;
    dcterms:description "Institutional mapping. Amsterdam UMC's internal mapping from its laboratory codes to LOINC. The contents are confidential; the FDP publishes only that the mapping exists, so other institutions can coordinate."@en ;
