@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix fdp:     <https://w3id.org/fdp/fdp-o#> .
@prefix r3d:     <http://www.re3data.org/schema/3-0#> .
@prefix ldp:     <http://www.w3.org/ns/ldp#> .
@prefix pim:     <http://www.w3.org/2000/10/swap/pim/doc#> .
@prefix :        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/> .

<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "Kik Rhd Meta Dataspace — index"@en ;
    dcterms:description "Index of this FAIR Data Point. Each sub-catalog describes one resource and lists every way to obtain it: native portal and APIs, bulk files, cloud buckets and copies in aggregators."@en ;
    dcterms:publisher :publisher-curator ;
    # Both addresses identify this FDP: the canonical IRI and the website that serves it (with text/turtle).
    dcterms:identifier "https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/" ,
        "https://amsterdamumc.github.io/kik-rhd-meta-dataspace/" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcat:landingPage <https://amsterdamumc.github.io/kik-rhd-meta-dataspace/> ;
    pim:persistencePolicy <https://github.com/AmsterdamUMC/kik-rhd-meta-dataspace/blob/main/PERSISTENCE.md> ;
    dcterms:modified "2026-10-08"^^xsd:date ;
    rdfs:seeAlso <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/vocab/access-methods.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/contributors.ttl> ;
    # The catalog documents themselves, for clients that follow LDP containment.
    ldp:contains
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/wikidata-fdp/catalog.ttl> ;
    fdp:hasCatalog
        :catalog-wikidata .

:catalog-wikidata
    a dcat:Catalog ;
    dcterms:title "Wikidata — example source (replace or remove)"@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/wikidata-fdp/catalog.ttl> .

:publisher-curator a foaf:Person ; foaf:name "andrawaag" ; foaf:homepage <https://github.com/andrawaag> .
