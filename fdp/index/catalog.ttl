<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "KIK RHD Meta Dataspace — index"@en ;
    dcterms:description "FAIR Data Point of the Reusable Health Data research line (KIK, Amsterdam UMC): the clinical terminologies, data models and mappings we use and publish, with every way to get them."@en ;
    dcterms:publisher :publisher-curator ;
    # Both addresses identify this FDP: the canonical IRI and the website that serves it (with text/turtle).
    dcterms:identifier "https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/" ,
        "https://amsterdamumc.github.io/kik-rhd-meta-dataspace/" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcat:landingPage <https://amsterdamumc.github.io/kik-rhd-meta-dataspace/> ;
    pim:persistencePolicy <https://github.com/AmsterdamUMC/kik-rhd-meta-dataspace/blob/main/PERSISTENCE.md> ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    rdfs:seeAlso <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/vocab/access-methods.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/index/contributors.ttl> ;
    # The catalog documents themselves, for clients that follow LDP containment.
    ldp:contains
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/loinc-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/icd-11-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/meddra-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/atc-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/ordo-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/hl7-fhir-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/omop-cdm-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/openehr-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/snomed-icd10-map-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/snomed-loinc-extension-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/omop-vocabulary-mappings-fdp/catalog.ttl> ,
        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/amc-lab-codes-loinc-fdp/catalog.ttl> ;
    fdp:hasCatalog
        :catalog-loinc ,
        :catalog-icd-11 ,
        :catalog-meddra ,
        :catalog-atc ,
        :catalog-ordo ,
        :catalog-hl7-fhir ,
        :catalog-omop-cdm ,
        :catalog-openehr ,
        :catalog-snomed-icd10-map ,
        :catalog-snomed-loinc-extension ,
        :catalog-omop-vocabulary-mappings ,
        :catalog-amc-lab-codes-loinc .

