@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix fdp:     <https://w3id.org/fdp/fdp-o#> .
@prefix r3d:     <http://www.re3data.org/schema/3-0#> .
@prefix am:      <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/vocab/access-methods#> .
@prefix :        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/snomed-icd10-map-fdp/> .

<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/snomed-icd10-map-fdp/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "SNOMED CT to ICD-10 map FAIR Data Point — KIK RHD Meta Dataspace"@en ;
    dcterms:publisher :publisher-source ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    fdp:hasCatalog :catalog .

:catalog
    a dcat:Catalog ;
    dcterms:title "SNOMED CT to ICD-10 map"@en ;
    dcterms:description "Layer 3, mapping. The map from SNOMED CT concepts to ICD-10 codes, published by SNOMED International. Links SNOMED CT and ICD-10/ICD-11 in this FDP."@en ;
    dcterms:publisher :publisher-source ;
    dcat:landingPage <https://www.snomed.org/maps> ;
    dcat:dataset :snomed-icd10-map-20261101 .

:snomed-icd10-map-20261101
    a dcat:Dataset ;
    dcterms:title "SNOMED CT to ICD-10 extended map, November 2026"@en ;
    dcterms:description "Part of the SNOMED CT International Edition, November 2026 release. Use requires a SNOMED CT Affiliate Licence; in the Netherlands it is free through Nictiz. This FDP describes how to get SNOMED CT and does not redistribute it."@en ;
    dcat:version "20261101" ;
    dcterms:issued "2026-11-01"^^xsd:date ;
    dcterms:publisher :publisher-source ;
    dcat:distribution :dist-snomed-ct-maps , :dist-map-files-via-mlds .

:dist-snomed-ct-maps
    a dcat:Distribution ;
    dcterms:title "SNOMED CT maps"@en ;
    dcterms:description "How to get it: Overview of the maps SNOMED International publishes."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://www.snomed.org/maps> .

:dist-map-files-via-mlds
    a dcat:Distribution ;
    dcterms:title "Map files via MLDS"@en ;
    dcterms:description "How to get it: The map is in the International Edition RF2 package."@en ;
    dcterms:type am:bulk-download ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/zip> ;
    dcat:accessURL <https://mlds.ihtsdotools.org/> .

:publisher-source a foaf:Organization ; foaf:name "SNOMED International"@en ; foaf:homepage <https://www.snomed.org/> .
:publisher-curator a foaf:Organization ; foaf:name "Amsterdam UMC" ; foaf:homepage <https://www.amsterdamumc.org/> ; dcterms:identifier <https://ror.org/05grdyy37> .
