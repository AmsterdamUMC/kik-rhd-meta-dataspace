<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/omop-vocabulary-mappings-fdp/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "OMOP Standardized Vocabularies and mappings FAIR Data Point — KIK RHD Meta Dataspace"@en ;
    dcterms:publisher :publisher-source ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    fdp:hasCatalog <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/omop-vocabulary-mappings-fdp/catalog.ttl#catalog> .

<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/omop-vocabulary-mappings-fdp/catalog.ttl#catalog>
    a dcat:Catalog ;
    dcterms:title "OMOP Standardized Vocabularies and mappings"@en ;
    dcterms:description "Layer 3, mapping. OHDSI's vocabularies with the mappings from source terminologies (SNOMED CT, LOINC, ATC, ICD-10 and others) to OMOP standard concepts."@en ;
    dcterms:publisher :publisher-source ;
    dcat:landingPage <https://athena.ohdsi.org/search-terms/start> ;
    dcat:dataset :omop-vocabulary-mappings-v20260829 .

:omop-vocabulary-mappings-v20260829
    a dcat:Dataset ;
    dcterms:title "OMOP Standardized Vocabularies v20260829"@en ;
    dcterms:description "Concepts and CONCEPT_RELATIONSHIP mappings, exported per vocabulary. Some vocabularies, such as SNOMED CT, need the source's own licence."@en ;
    dcat:version "v20260829" ;
    dcterms:publisher :publisher-source ;
    dcat:distribution :dist-athena-search-concepts-and-mappings , :dist-athena-vocabulary-download .

:dist-athena-search-concepts-and-mappings
    a dcat:Distribution ;
    dcterms:title "Athena: search concepts and mappings"@en ;
    dcterms:description "How to get it: Search a concept; its relationships show the mappings."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://athena.ohdsi.org/search-terms/start> .

:dist-athena-vocabulary-download
    a dcat:Distribution ;
    dcterms:title "Athena vocabulary download"@en ;
    dcterms:description "How to get it: Log in, tick the vocabularies you need, accept their licences and download the CSV bundle."@en ;
    dcterms:type am:bulk-download ;
    dcat:accessURL <https://athena.ohdsi.org/vocabulary/list> .

