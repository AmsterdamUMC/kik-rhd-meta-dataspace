@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix fdp:     <https://w3id.org/fdp/fdp-o#> .
@prefix r3d:     <http://www.re3data.org/schema/3-0#> .
@prefix am:      <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/vocab/access-methods.ttl#> .
@prefix :        <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/openehr-fdp/> .

<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/openehr-fdp/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "openEHR FAIR Data Point — KIK RHD Meta Dataspace"@en ;
    dcterms:publisher :publisher-source ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    fdp:hasCatalog <https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/openehr-fdp/catalog.ttl#catalog> .

<https://raw.githubusercontent.com/AmsterdamUMC/kik-rhd-meta-dataspace/main/fdp/openehr-fdp/catalog.ttl#catalog>
    a dcat:Catalog ;
    dcterms:title "openEHR"@en ;
    dcterms:description "Layer 2, data model. Specifications for electronic health records: a reference model plus archetypes and templates."@en ;
    dcterms:publisher :publisher-source ;
    dcat:landingPage <https://specifications.openehr.org/> ;
    dcat:dataset :openehr-rm-release-1-1-0 .

:openehr-rm-release-1-1-0
    a dcat:Dataset ;
    dcterms:title "openEHR Reference Model Release 1.1.0"@en ;
    dcterms:description "Reference Model Release 1.1.0 (with BASE Release 1.2.0), and the other specification components: Archetype Model, AQL and more."@en ;
    dcat:version "RM Release-1.1.0" ;
    dcterms:publisher :publisher-source ;
    dcat:distribution :dist-openehr-specifications , :dist-clinical-knowledge-manager , :dist-ehrbase .

:dist-openehr-specifications
    a dcat:Distribution ;
    dcterms:title "openEHR specifications"@en ;
    dcterms:description "How to get it: Read each component per release online."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://specifications.openehr.org/> .

:dist-clinical-knowledge-manager
    a dcat:Distribution ;
    dcterms:title "Clinical Knowledge Manager"@en ;
    dcterms:description "How to get it: Browse and download the international archetypes and templates."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://ckm.openehr.org/ckm/> .

:dist-ehrbase
    a dcat:Distribution ;
    dcterms:title "EHRbase"@en ;
    dcterms:description "How to get it: Open-source openEHR server, to run openEHR yourself."@en ;
    dcterms:type am:source-repository ;
    dcat:accessURL <https://ehrbase.org/> .

:publisher-source a foaf:Organization ; foaf:name "openEHR International"@en ; foaf:homepage <https://openehr.org/> .
:publisher-curator a foaf:Organization ; foaf:name "Amsterdam UMC" ; foaf:homepage <https://www.amsterdamumc.org/> ; dcterms:identifier <https://ror.org/05grdyy37> .
